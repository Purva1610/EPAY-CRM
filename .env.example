# Firebase Configuration for ePay CRM
# Copy this file to .env and fill in your actual values

# Environment name (development, staging, or production)
NODE_ENV=development

# Firebase API Key
FIREBASE_API_KEY=your_api_key_here

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Firebase App ID
FIREBASE_APP_ID=your_app_id

# Firebase Measurement ID (for Google Analytics)
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app

# ============================================
# SendGrid Email Configuration
# ============================================
VITE_SENDGRID_API_KEY=SG.xxx
VITE_SENDGRID_FROM_EMAIL=noreply@epaycrm.com

# ============================================
# Twilio VoIP Configuration
# ============================================
VITE_TWILIO_ACCOUNT_SID=your_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_auth_token_here
VITE_TWILIO_FROM_NUMBER=+1234567890

# ============================================
# Session Timer Configuration
# ============================================
VITE_INACTIVITY_THRESHOLD_MS=900000
VITE_BREAK_START_HOUR=13
VITE_BREAK_END_HOUR=14
VITE_SHIFT_END_HOUR=18

# ============================================
# Feature Toggles
# ============================================
VITE_EMAIL_ENABLED=true
VITE_CALLING_ENABLED=true
VITE_SESSION_TIMER_ENABLED=true

